[Unit]
Description=AETHER//PROTOCOL — Battleground persistent server
After=network.target

[Service]
Type=simple
# Adjust this to wherever you deployed the repo on the VM
WorkingDirectory=/opt/aether/AetherProtocol/server
ExecStart=/usr/bin/node index.js
Environment=PORT=8080
Restart=always
RestartSec=3
# Run as whichever user owns the checkout — if that's a home directory (e.g.
# /home/<you>/...), a separate system user usually can't even cd into it,
# since home dirs are typically mode 700. Simplest correct answer for a
# single-user VM: use your own account here (see README step 5).
User=opc
# Hardening: the process only needs to read its own repo checkout and talk on the network
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
